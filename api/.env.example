# Copy to .env and fill in values — never commit .env
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Optional: download the fine-tuned image checkpoint from a Hugging Face Hub
# model repo instead of expecting it at the local models/image_detector.pt path.
PRISM_IMAGE_MODEL_REPO=
PRISM_IMAGE_MODEL_FILENAME=image_detector.pt
